{
  "expo": {
    "name": "SchoolMitra Parent",
    "slug": "schoolmitra-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "schoolmitraparent",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolmitra.parent",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.schoolmitra.parent",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1b4b"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ea867b43-9c80-412b-9c84-5fe04755f945"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/parent_app_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#1e1b4b"
        }
      ]
    ]
  }
}
